# AWS認証情報そのものは書かず、設定済みプロファイル名を指定します。
# プロファイルを指定する場合は次の行のコメントを外して変更してください。
# AWS_PROFILE=default

# 利用するリージョンと、そのリージョンで利用可能なモデルIDを設定してください。
AWS_REGION=
BEDROCK_MODEL_ID=

# 初期値はstream。全文をまとめて返す場合はjsonを指定します。
RESPONSE_MODE=stream

# Gateway追加後に取得したURL。Gatewayを使う場合のみ設定する。
AGENTCORE_GATEWAY_CODECHATSEARCH_URL=
