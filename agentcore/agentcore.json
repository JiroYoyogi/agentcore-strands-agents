{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CodeChat",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CodeChat"
  },
  "runtimes": [
    {
      "name": "CodeChatAgent",
      "build": "CodeZip",
      "entrypoint": "main.js",
      "codeLocation": "./app/agent",
      "runtimeVersion": "NODE_22",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "global.anthropic.claude-sonnet-4-6"
        },
        {
          "name": "AGENTCORE_GATEWAY_CODECHATSEARCH_URL",
          "value": "https://codechat-codechatsearch-ceazcjpnfc.gateway.bedrock-agentcore.ap-northeast-1.amazonaws.com"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CodeChatSearch",
      "protocolType": "None",
      "description": "Gateway for CodeChatSearch",
      "targets": [
        {
          "name": "WebSearch",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "description": "",
              "parameterValues": {},
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}