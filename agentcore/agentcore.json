{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CodeChat",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CodeChat"
  },
  "runtimes": [
    {
      "name": "CodeChatAgent",
      "build": "CodeZip",
      "entrypoint": "main.js",
      "codeLocation": "./app/agent",
      "runtimeVersion": "NODE_22",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "global.anthropic.claude-sonnet-4-6"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}